{
  "name": "@cam5/baby-bird",
  "version": "0.1.1",
  "description": "Guided code tours for git changes, on the command line.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cam5/baby-bird.git"
  },
  "keywords": [
    "git",
    "code-review",
    "diff",
    "llm",
    "cli",
    "code-tour"
  ],
  "bin": {
    "bb": "dist/cli.js",
    "baby-bird": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "tsx src/cli/main.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "lowlight": "^3.3.0",
    "picocolors": "^1.1.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
